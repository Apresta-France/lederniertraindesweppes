# Le Dernier Train des Weppes
# Copie locale : ce fichier sert de modèle. Le site crée .env à l'installation.

APP_ENV="local"
APP_URL="http://lederniertraindesweppes.test"
APP_NAME="Le Dernier Train des Weppes"
APP_KEY=""
DB_PATH="storage/database.sqlite"

# SMTP : « log » écrit les messages dans storage/logs sans envoi réseau.
# En production : serveur, identifiant et adresse du même domaine (SPF).
SMTP_HOST="log"
SMTP_PORT="587"
SMTP_ENCRYPTION="tls"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_ADDRESS="bonjour@lederniertraindesweppes.fr"
MAIL_FROM_NAME="Le Dernier Train des Weppes"
MAIL_TO="contact@lederniertraindesweppes.fr"

LEGAL_NAME="Groupe Tercium"
LEGAL_EMAIL=""
LEGAL_ADDRESS=""
LEGAL_HOST=""
