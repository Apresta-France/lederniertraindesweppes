        { "src": "assets/boite_fermee.png" }
      ],
      "text": "Une vieille boîte à biscuits, peinte de roses et de feuillages. Le couvercle est un peu cabossé, la peinture usée aux coins à force d'avoir été ouverte.",
      "facts": [
        { "label": "Où", "value": "Sur l'étagère, sous la télévision" },
        { "label": "Matière", "value": "Fer peint" },
        { "label": "Fermeture", "value": "Petit cadenas en laiton" },
        { "label": "État", "value": "Ouverte", "when": { "state": "boite", "eq": "ouverte" } },
        { "label": "État", "value": "Fermée à clé", "when": { "state": "boite", "ne": "ouverte" } }
      ],
      "actions": [
        {
          "label": "Essayer d'ouvrir",
          "when": { "state": "boite", "ne": "ouverte" },
          "do": [
            { "do": "sfx", "name": "click" },
            { "do": "panelNote", "text": "Le cadenas tient bon. Il faudrait trouver la clé." },
            {
              "do": "note",
              "text": "La boîte en fer de l'étagère est fermée par un cadenas. Trouver la clé."
            },
            { "do": "set", "var": "chambre-gisele-aurelie.boite-essayee", "value": true }
          ]
        },
        { "label": "Reposer", "style": "ghost", "do": [{ "do": "close" }] }
