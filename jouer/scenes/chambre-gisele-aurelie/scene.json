    {
      "do": "if",
      "cond": { "not": { "var": "chambre-gisele-aurelie.entree" } },
      "then": [
        { "do": "set", "var": "chambre-gisele-aurelie.entree", "value": true },
        { "do": "wait", "ms": 1500 },
        { "do": "objective", "complete": "rejoindre" }
      ]
    }
  ],
