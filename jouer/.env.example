# Environnement propre au jeu. Il n'est pas partagé avec le site vitrine.
GAME_ENV=local
GAME_URL=http://lederniertraindesweppes.test/jouer

# Panneau de débogage du jeu (on/off/auto). Réglable depuis l'administration (Environnement) ;
# défini ici, il prend le pas sur l'administration. En auto : on si GAME_ENV (ou APP_ENV du site) vaut local.
GAME_DEBUG=on
# Éditeur de scènes (on/off), réservé aux administrateurs du site.
GAME_EDITOR=on
