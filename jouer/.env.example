# Environnement propre au jeu. Il n'est pas partagé avec le site vitrine.
GAME_ENV=local
GAME_URL=http://lederniertraindesweppes.test/jouer

# Panneau de débogage du jeu (on/off). Par défaut : on si GAME_ENV=local.
GAME_DEBUG=on
# Éditeur de scènes (on/off), réservé aux administrateurs du site.
GAME_EDITOR=on
