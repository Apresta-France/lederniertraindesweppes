Options -Indexes
DirectoryIndex index.html index.php

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Les modules JS s'importent sans numéro de version : sans revalidation, le navigateur
# mélange d'anciens fichiers du moteur avec les nouveaux.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
